{
  "name": "ajaymekala-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio site for Ajay Mekala, AI/ML Engineer",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "export": "STATIC_EXPORT=true next build",
    "resume:pdf": "node scripts/build-resume-pdf.mjs",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "lighthouse": "node scripts/lighthouse.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@shikijs/rehype": "4.4.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "cmdk": "1.1.1",
    "gray-matter": "4.0.3",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "1.45.0",
    "motion": "13.2.0",
    "next": "15.5.25",
    "next-mdx-remote": "6.0.0",
    "ogl": "1.0.11",
    "playwright-core": "^1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "shiki": "4.4.3",
    "zod": "4.6.4"
